# Copy this file to sync/.env and fill it in. sync/.env is never committed.

# From https://www.tumblr.com/oauth/apps (OAuth consumer key and secret)
TUMBLR_CLIENT_ID=
TUMBLR_CLIENT_SECRET=

# Your blog's name, e.g. fyi-photos (for fyi-photos.tumblr.com)
TUMBLR_BLOG=

# Your photos folder. An absolute path works best, e.g. /Users/you/Pictures/fyi-photos
PHOTOS_DIR=
